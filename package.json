{
  "name": "envlockup",
  "version": "0.2.2",
  "description": "Encrypted .env files you can commit. Decrypt with the SSH key you already have.",
  "keywords": [
    "dotenv",
    "env",
    "secrets",
    "encryption",
    "ssh",
    "age"
  ],
  "license": "MIT",
  "author": "denisbilli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisbilli/envlockup.git"
  },
  "type": "module",
  "bin": {
    "envlockup": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "vectors": "npm run build && node scripts/make-vectors.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "bcrypt-pbkdf": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.7.0"
  }
}
